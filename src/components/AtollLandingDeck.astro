---
import type { AppRecord } from "../data/site";

interface Props {
  app: AppRecord;
}

const { app } = Astro.props;
const ctaHref = app.downloadUrl ?? app.appStoreUrl;
const agentHarnesses = [
  ["claude", "Claude Code"],
  ["codex", "Codex"],
  ["cursor", "Cursor Agent"],
  ["opencode", "OpenCode"],
  ["pi", "Pi"],
];
---

<main class="atoll-page givdul-app-landing" data-motion-root aria-label="Topside for Mac">
  <section class="atoll-hero" aria-label="Overview">
    <div class="atoll-hero__copy">
      <h1 data-reveal data-reveal-delay="60">Topside</h1>
      <p class="atoll-hero__lede" data-reveal data-reveal-delay="120">
        A Mac menu bar app that shows local coding agent status in a small island around the notch.
      </p>
    </div>

    <div class="atoll-hero__stage" data-reveal data-reveal-delay="120">
      <section class="macbook" aria-label={app.heroVisualLabel}>
        <div class="macbook__screen">
          <div class="macbook__bezel">
            <div class="atoll-island" data-atoll-island data-state="permission" data-visible-state="permission" data-phase="settled" tabindex="0" aria-label="Topside agent lifecycle preview">
              <div class="atoll-island__notch" aria-hidden="true">
                <span class="atoll-notch-runner atoll-notch-runner--tail atoll-notch-runner--tail-12"></span>
                <span class="atoll-notch-runner atoll-notch-runner--tail atoll-notch-runner--tail-11"></span>
                <span class="atoll-notch-runner atoll-notch-runner--tail atoll-notch-runner--tail-10"></span>
                <span class="atoll-notch-runner atoll-notch-runner--tail atoll-notch-runner--tail-9"></span>
                <span class="atoll-notch-runner atoll-notch-runner--tail atoll-notch-runner--tail-8"></span>
                <span class="atoll-notch-runner atoll-notch-runner--tail atoll-notch-runner--tail-7"></span>
                <span class="atoll-notch-runner atoll-notch-runner--tail atoll-notch-runner--tail-6"></span>
                <span class="atoll-notch-runner atoll-notch-runner--tail atoll-notch-runner--tail-5"></span>
                <span class="atoll-notch-runner atoll-notch-runner--tail atoll-notch-runner--tail-4"></span>
                <span class="atoll-notch-runner atoll-notch-runner--tail atoll-notch-runner--tail-3"></span>
                <span class="atoll-notch-runner atoll-notch-runner--tail atoll-notch-runner--tail-2"></span>
                <span class="atoll-notch-runner atoll-notch-runner--tail atoll-notch-runner--tail-1"></span>
                <span class="atoll-notch-runner atoll-notch-runner--head"></span>
                <svg class="atoll-notch-svg" viewBox="0 0 132 36" width="132" height="36">
                  <path class="atoll-notch-svg__edge atoll-notch-svg__edge--base" d="M132 2V19.44Q132 36 115.44 36H16.56Q0 36 0 19.44V2"></path>
                  <path class="atoll-notch-svg__fill" d="M0 0H132V19.44Q132 36 115.44 36H16.56Q0 36 0 19.44Z"></path>
                  <path class="atoll-notch-svg__hairline" d="M0 0H132V19.44Q132 36 115.44 36H16.56Q0 36 0 19.44Z"></path>
                </svg>
                <div class="atoll-island__hint" aria-hidden="true">Hover me</div>
              </div>

              <div class="atoll-island__rows">
                <div class="atoll-row atoll-row--running atoll-row--opencode" data-state-row="running">
                  <span class="atoll-row__icon-well"><img src="/atoll-agent-icons/opencode.svg" alt="" /></span>
                  <span class="atoll-row__title">Update checkout copy</span>
                  <span class="atoll-row__status"><svg class="atoll-status-icon atoll-status-icon--terminal" viewBox="0 0 14 14" aria-hidden="true"><rect x="1.6" y="2.4" width="10.8" height="9.2" rx="1.8" /><path d="M3.7 5.4 5.5 7 3.7 8.6M6.6 8.7h3.1" /></svg><span class="atoll-row__timer" data-start-seconds="7">07s</span></span>
                  <span class="atoll-row__activity" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></span>
                </div>
                <div class="atoll-row atoll-row--running atoll-row--codex" data-state-row="running">
                  <span class="atoll-row__icon-well"><img src="/atoll-agent-icons/codex.svg" alt="" /></span>
                  <span class="atoll-row__title">Fix onboarding layout</span>
                  <span class="atoll-row__status"><svg class="atoll-status-icon atoll-status-icon--terminal" viewBox="0 0 14 14" aria-hidden="true"><rect x="1.6" y="2.4" width="10.8" height="9.2" rx="1.8" /><path d="M3.7 5.4 5.5 7 3.7 8.6M6.6 8.7h3.1" /></svg><span class="atoll-row__timer" data-start-seconds="18">18s</span></span>
                  <span class="atoll-row__activity" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></span>
                </div>
                <div class="atoll-row atoll-row--running atoll-row--claude" data-state-row="running">
                  <span class="atoll-row__icon-well"><img src="/atoll-agent-icons/claude.svg" alt="" /></span>
                  <span class="atoll-row__title">Review auth edge case</span>
                  <span class="atoll-row__status"><svg class="atoll-status-icon atoll-status-icon--terminal" viewBox="0 0 14 14" aria-hidden="true"><rect x="1.6" y="2.4" width="10.8" height="9.2" rx="1.8" /><path d="M3.7 5.4 5.5 7 3.7 8.6M6.6 8.7h3.1" /></svg><span class="atoll-row__timer" data-start-seconds="42">42s</span></span>
                  <span class="atoll-row__activity" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></span>
                </div>
                <div class="atoll-row atoll-row--running atoll-row--pi" data-state-row="running">
                  <span class="atoll-row__icon-well"><img src="/atoll-agent-icons/pi.svg" alt="" /></span>
                  <span class="atoll-row__title">Monitor agent lifecycle</span>
                  <span class="atoll-row__status"><svg class="atoll-status-icon atoll-status-icon--terminal" viewBox="0 0 14 14" aria-hidden="true"><rect x="1.6" y="2.4" width="10.8" height="9.2" rx="1.8" /><path d="M3.7 5.4 5.5 7 3.7 8.6M6.6 8.7h3.1" /></svg><span class="atoll-row__timer" data-start-seconds="64">01m</span></span>
                  <span class="atoll-row__activity" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></span>
                </div>
                <div class="atoll-row atoll-row--running atoll-row--cursor" data-state-row="running">
                  <span class="atoll-row__icon-well"><img src="/atoll-agent-icons/cursor.svg" alt="" /></span>
                  <span class="atoll-row__title">Polish settings search</span>
                  <span class="atoll-row__status"><svg class="atoll-status-icon atoll-status-icon--terminal" viewBox="0 0 14 14" aria-hidden="true"><rect x="1.6" y="2.4" width="10.8" height="9.2" rx="1.8" /><path d="M3.7 5.4 5.5 7 3.7 8.6M6.6 8.7h3.1" /></svg><span class="atoll-row__timer" data-start-seconds="91">01m</span></span>
                  <span class="atoll-row__activity" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></span>
                </div>
                <div class="atoll-row atoll-row--running atoll-row--cursor" data-state-row="running">
                  <span class="atoll-row__icon-well"><img src="/atoll-agent-icons/cursor.svg" alt="" /></span>
                  <span class="atoll-row__title">Review generated changes</span>
                  <span class="atoll-row__status"><svg class="atoll-status-icon atoll-status-icon--terminal" viewBox="0 0 14 14" aria-hidden="true"><rect x="1.6" y="2.4" width="10.8" height="9.2" rx="1.8" /><path d="M3.7 5.4 5.5 7 3.7 8.6M6.6 8.7h3.1" /></svg><span class="atoll-row__timer" data-start-seconds="128">02m</span></span>
                  <span class="atoll-row__activity" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></span>
                </div>
                <div class="atoll-row atoll-row--input" data-state-row="input">
                  <span class="atoll-row__icon-well"><img src="/atoll-agent-icons/codex.svg" alt="" /></span>
                  <span class="atoll-row__title">Choose migration strategy</span>
                  <span class="atoll-row__status"><svg class="atoll-status-icon" viewBox="0 0 14 14" aria-hidden="true"><path d="M5 4.6a2.1 2.1 0 1 1 3.2 1.8c-.8.5-1.2.9-1.2 1.8M7 10.7h.01" /></svg><span class="atoll-row__timer" data-start-seconds="3">03s</span></span>
                </div>
                <div class="atoll-row atoll-row--permission" data-state-row="permission">
                  <span class="atoll-row__icon-well"><img src="/atoll-agent-icons/codex.svg" alt="" /></span>
                  <span class="atoll-row__title">Approve git push</span>
                  <span class="atoll-row__status"><svg class="atoll-status-icon atoll-status-icon--hand" viewBox="0 0 14 14" aria-hidden="true"><path d="M4.5 7.4V3.1a.8.8 0 0 1 1.6 0v3.2M6.1 6V2.4a.8.8 0 0 1 1.6 0V6M7.7 6.2V3a.8.8 0 0 1 1.6 0v3.8M9.3 7.1V4.6a.8.8 0 0 1 1.6 0v3.7c0 2.2-1.4 3.8-3.5 3.8H6.3c-1.1 0-1.9-.5-2.6-1.5L2.2 8.4a.85.85 0 0 1 1.3-1.1l1 1.2" /></svg><span class="atoll-row__timer" data-start-seconds="11">11s</span></span>
                </div>
                <div class="atoll-row atoll-row--finished" data-state-row="finished">
                  <span class="atoll-row__icon-well"><img src="/atoll-agent-icons/codex.svg" alt="" /></span>
                  <span class="atoll-row__title">Merged import cleanup</span>
                  <span class="atoll-row__status"><svg class="atoll-status-icon" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 7.3 5.7 10 11 4" /></svg><span class="atoll-row__timer" data-start-seconds="8">08s</span></span>
                </div>
                <div class="atoll-row atoll-row--failed" data-state-row="failed">
                  <span class="atoll-row__icon-well"><img src="/atoll-agent-icons/claude.svg" alt="" /></span>
                  <span class="atoll-row__title">Build app bundle</span>
                  <span class="atoll-row__status"><svg class="atoll-status-icon" viewBox="0 0 14 14" aria-hidden="true"><path d="m4 4 6 6M10 4l-6 6" /></svg><span class="atoll-row__timer" data-start-seconds="19">19s</span></span>
                </div>
                <div class="atoll-row atoll-row--cancelled" data-state-row="cancelled">
                  <span class="atoll-row__icon-well"><img src="/atoll-agent-icons/cursor.svg" alt="" /></span>
                  <span class="atoll-row__title">Stop generated changes</span>
                  <span class="atoll-row__status"><svg class="atoll-status-icon" viewBox="0 0 14 14" aria-hidden="true"><path d="M4.2 4.2 9.8 9.8M9.8 4.2 4.2 9.8" /></svg><span class="atoll-row__timer" data-start-seconds="27">27s</span></span>
                </div>
              </div>
            </div>

            <div class="macbook__wallpaper">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="macbook__screen-content">
              <section class="agent-dock" aria-label="Supported agent harnesses">
                <div class="agent-dock__shelf">
                  {agentHarnesses.map(([slug, label]) => (
                    <span class="agent-dock__item" aria-label={label}>
                      <span class="agent-dock__visual">
                        <img src={`/atoll-agent-icons/${slug}.svg`} alt={label} width="28" height="28" loading="lazy" />
                      </span>
                      <span class="agent-dock__tooltip" aria-hidden="true">{label}</span>
                    </span>
                  ))}
                </div>
              </section>
            </div>

            <div class="macbook__cta" data-reveal data-reveal-delay="220">
              {ctaHref ? (
                <a class="button button--pro" href={ctaHref} rel="noreferrer" aria-label="Download Topside for Mac">
                  <span>Download Topside</span>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M8 2v8M5 7l3 3 3-3M3 13h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              ) : (
                <span class="button button--pro button--disabled" aria-disabled="true">Coming soon</span>
              )}
            </div>
          </div>
        </div>
        <div class="macbook__base" aria-hidden="true"></div>

      </section>
    </div>
  </section>

</main>

<script>
  const setupAtollPreview = () => {
    const island = document.querySelector("[data-atoll-island]");
    if (!(island instanceof HTMLElement)) return;
    const states = ["running", "input", "permission", "finished", "failed", "cancelled"];
    let cycleIndex = states.indexOf(island.dataset.state ?? "permission");
    let cycleTimer;
    let timerInterval;
    let leaveTimer;
    let enterTimer;
    let hintTimer;
    let hasSeenRunningDetails = false;
    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    const timers = [...island.querySelectorAll(".atoll-row__timer")];
    const stateDelay = {
      running: 4200,
      input: 5000,
      permission: 5000,
      finished: 4200,
      failed: 4200,
      cancelled: 4200,
    };

    const formatElapsed = (seconds) => {
      if (seconds < 60) return `${String(seconds).padStart(2, "0")}s`;
      return `${String(Math.floor(seconds / 60)).padStart(2, "0")}m`;
    };

    const updateTimers = () => {
      timers.forEach((timer) => {
        const startSeconds = Number(timer.dataset.startSeconds ?? 0);
        const startedAt = Number(timer.dataset.startedAt ?? Date.now());
        timer.dataset.startedAt = String(startedAt);
        timer.textContent = formatElapsed(startSeconds + Math.floor((Date.now() - startedAt) / 1000));
      });
    };

    const setState = (state) => {
      if (island.dataset.state === state && island.dataset.phase !== "leaving") return;
      window.clearTimeout(leaveTimer);
      window.clearTimeout(enterTimer);
      window.clearTimeout(hintTimer);
      delete island.dataset.runningExpanded;
      delete island.dataset.showHint;

      if (motionQuery.matches) {
        island.dataset.state = state;
        island.dataset.visibleState = state;
        island.dataset.phase = "settled";
        return;
      }

      const fromState = island.dataset.visibleState ?? island.dataset.state ?? state;
      island.dataset.state = state;
      island.dataset.visibleState = fromState;
      island.dataset.phase = "leaving";

      leaveTimer = window.setTimeout(() => {
        if (island.dataset.state === state) {
          island.dataset.visibleState = state;
          island.dataset.phase = "entering";

          enterTimer = window.setTimeout(() => {
            if (island.dataset.state === state) {
              island.dataset.phase = "settled";
              if (state === "running" && !hasSeenRunningDetails) {
                hintTimer = window.setTimeout(() => {
                  if (island.dataset.state === "running" && !island.dataset.runningExpanded) {
                    island.dataset.showHint = "true";
                  }
                }, 1300);
              }
            }
          }, 420);
        }
      }, 460);
    };

    const stopActivity = () => {
      window.clearTimeout(cycleTimer);
      window.clearInterval(timerInterval);
      window.clearTimeout(leaveTimer);
      window.clearTimeout(enterTimer);
      window.clearTimeout(hintTimer);
      cycleTimer = undefined;
      timerInterval = undefined;
      leaveTimer = undefined;
      enterTimer = undefined;
      hintTimer = undefined;
    };

    const scheduleNext = (delay) => {
      window.clearTimeout(cycleTimer);
      cycleTimer = window.setTimeout(() => {
        cycleIndex = (cycleIndex + 1) % states.length;
        setState(states[cycleIndex]);
        scheduleNext(stateDelay[states[cycleIndex]]);
      }, delay);
    };

    const startActivity = () => {
      if (motionQuery.matches) return;
      window.clearInterval(timerInterval);
      updateTimers();
      timerInterval = window.setInterval(updateTimers, 1000);
      scheduleNext(stateDelay[states[cycleIndex]]);
    };

    const expandRunning = () => {
      if (island.dataset.state !== "running") return;
      hasSeenRunningDetails = true;
      window.clearTimeout(hintTimer);
      delete island.dataset.showHint;
      island.dataset.runningExpanded = "true";
    };

    const collapseRunning = () => {
      if (island.dataset.state !== "running" || !island.dataset.runningExpanded) return;
      delete island.dataset.runningExpanded;
    };

    const handleMotionPreference = () => {
      if (motionQuery.matches) {
        setState("permission");
        stopActivity();
        return;
      }

      cycleIndex = states.indexOf(island.dataset.state ?? "permission");
      startActivity();
    };

    island.addEventListener("mouseenter", expandRunning);
    island.addEventListener("pointerenter", expandRunning);
    island.addEventListener("focus", expandRunning);
    island.addEventListener("mouseleave", collapseRunning);
    island.addEventListener("pointerleave", collapseRunning);
    island.addEventListener("blur", collapseRunning);

    setState(motionQuery.matches ? "permission" : states[cycleIndex]);
    if (motionQuery.matches) {
      stopActivity();
    } else {
      startActivity();
    }
    motionQuery.addEventListener("change", handleMotionPreference);

    window.addEventListener("pagehide", () => {
      stopActivity();
      motionQuery.removeEventListener("change", handleMotionPreference);
    }, { once: true });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupAtollPreview, { once: true });
  } else {
    setupAtollPreview();
  }
</script>

<style>
  .atoll-page {
    --atoll-running: #ff851a;
    --atoll-input: #38c7ff;
    --atoll-permission: #ff334a;
    --atoll-finished: #38f26b;
    --atoll-failed: #ff6b35;
    --atoll-cancelled: #b88cff;
    flex: 1 1 auto;
    display: flex;
    width: 100%;
    max-width: min(1360px, calc(100dvw - 1.5rem));
    margin: 0 auto;
    padding: 0 0 clamp(0.75rem, 1.5svh, 1.25rem);
  }

  .atoll-hero {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1rem, 2.5svh, 2rem);
  }

  .atoll-hero__copy {
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
  }

  .atoll-hero h1 {
    display: flex;
    align-items: baseline;
    justify-content: center;
    margin: 0;
    font-family: var(--theme-font-display);
    font-size: clamp(3.7rem, 9vw, 6.15rem);
    line-height: 0.9;
    letter-spacing: 0;
  }

  .atoll-hero h1 span {
    transition: opacity 180ms ease;
  }

  .atoll-hero h1:hover span {
    opacity: 0.78;
  }

  .atoll-hero__glyph-slot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 0.62em;
    height: 0.48em;
    margin: 0 0.03em;
    transform: translateY(0.02em);
  }

  .atoll-hero__glyph-o {
    width: auto;
    height: 100%;
  }

  .atoll-hero__lede {
    margin: 1rem auto 0;
    max-width: 39rem;
    color: var(--theme-text-secondary);
    font-size: clamp(1rem, 1.7vw, 1.18rem);
  }

  .atoll-hero__stage {
    min-width: 0;
    width: 100%;
  }

  .macbook {
    position: relative;
    width: min(100%, 1060px, max(34rem, calc((100svh - 22rem) * 1.58)));
    margin-inline: auto;
    padding-bottom: clamp(2.5rem, 5svh, 4.25rem);
  }

  .macbook__screen {
    position: relative;
    aspect-ratio: 1.58;
    border-radius: 1.4rem 1.4rem 0.8rem 0.8rem;
    padding: 0.7rem;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.32), rgb(255 255 255 / 0.05) 32%, rgb(0 0 0 / 0.58)),
      #171719;
    box-shadow: 0 3rem 5rem rgb(0 0 0 / 0.38);
  }

  .macbook__bezel {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 0.9rem 0.9rem 0.45rem 0.45rem;
    background: #050506;
  }

  .macbook__wallpaper {
    position: absolute;
    inset: 1.4rem;
    top: 2.1rem;
    z-index: 0;
    overflow: hidden;
    border-radius: 0.45rem;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.5), rgb(0 0 0 / 0.12) 40%, rgb(0 0 0 / 0.62)),
      linear-gradient(90deg, rgb(0 0 0 / 0.42), transparent 34%, rgb(0 0 0 / 0.18)),
      url("/atoll-wallpaper.webp") center / cover no-repeat;
  }

  .macbook__wallpaper::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 52% 38%, transparent, rgb(0 0 0 / 0.32) 72%);
  }

  .macbook__wallpaper span {
    position: absolute;
    inset: auto 9% 14%;
    height: 1px;
    background: rgb(255 255 255 / 0.14);
  }

  .macbook__wallpaper span:nth-child(2) {
    bottom: 22%;
    opacity: 0.5;
  }

  .macbook__wallpaper span:nth-child(3) {
    bottom: 30%;
    opacity: 0.24;
  }

  .macbook__screen-content {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: end;
    padding: min(9vw, 5.9rem) clamp(2rem, 4.6vw, 4.2rem) clamp(0.95rem, 2.1vw, 1.55rem);
    pointer-events: none;
  }

  .agent-dock {
    --dock-icon-size: clamp(1.95rem, 3.55vw, 2.75rem);
    --dock-dot-space: 0.72rem;
    --dock-plate-height: calc(var(--dock-icon-size) + var(--dock-dot-space) + var(--dock-dot-space));
    --dock-hover-lift: 1.28rem;
    --dock-tooltip-scale-lift: clamp(1.15rem, 1.9vw, 1.55rem);
    width: max-content;
    max-width: 100%;
    margin-inline: auto;
    pointer-events: auto;
  }

  .agent-dock__shelf {
    position: relative;
    display: flex;
    align-items: end;
    justify-content: center;
    gap: clamp(0.28rem, 0.8vw, 0.5rem);
    min-height: calc(var(--dock-plate-height) + 1.25rem);
    padding: 0 clamp(0.42rem, 0.9vw, 0.62rem);
    border-radius: 1.65rem 1.65rem 1.25rem 1.25rem;
    transform-origin: center bottom;
    transition: transform 180ms var(--ease-out-quart);
  }

  .agent-dock:hover .agent-dock__shelf {
    transform: translateY(-0.06rem);
  }

  .agent-dock__shelf::before,
  .agent-dock__shelf::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .agent-dock__shelf::before {
    inset: auto 0 0;
    z-index: 0;
    height: var(--dock-plate-height);
    border-radius: 1.65rem 1.65rem 1.25rem 1.25rem;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.33), rgb(255 255 255 / 0.14) 12%, rgb(255 255 255 / 0.06) 70%, rgb(255 255 255 / 0.12)),
      rgb(34 35 37 / 0.44);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.18),
      inset 0 1px 0 rgb(255 255 255 / 0.48),
