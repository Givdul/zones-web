---
import type { AppRecord } from "../data/site";
import { site } from "../data/site";

interface Props {
  app?: AppRecord;
  ctaLabel?: string;
  revealOnScroll?: boolean;
}

const { app, ctaLabel, revealOnScroll = false } = Astro.props;
const ctaHref = app?.downloadUrl ?? app?.appStoreUrl;
const resolvedCtaLabel = ctaLabel ?? (app?.downloadUrl ? "Download for Mac" : "Download on the App Store");
const brandIconPath = app?.iconPath ?? null;
---

<header class:list={["site-header", revealOnScroll && "site-header--scroll-reveal"]}>
  <div class="site-header__inner">
    <a class="brandmark" href={app ? app.landingPath : "/"} aria-label={`${app ? app.name : site.name} home`}>
      {brandIconPath ? (
        <img src={brandIconPath} alt="" width="44" height="44" />
      ) : (
        <span class="brandmark__tile" aria-hidden="true">{site.brand.slice(0, 1)}</span>
      )}
      <span>
        <strong>{app ? app.name : site.name}</strong>
        {!app && <small>Focused Mac utilities</small>}
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <a href="/">Apps</a>
      {app && <a href={app.supportPath}>Support</a>}
      {app && <a href={app.privacyPath}>Privacy</a>}
      {ctaHref && (
        app?.downloadUrl ? (
          <a class="button button--catalog" href={ctaHref} rel="noreferrer" aria-label={resolvedCtaLabel}>
            {resolvedCtaLabel}
          </a>
        ) : (
          <a class="app-store-badge" href={ctaHref} target="_blank" rel="noreferrer" aria-label={resolvedCtaLabel}>
            <img src="/download-on-the-app-store.svg" alt={resolvedCtaLabel} />
          </a>
        )
      )}
    </nav>
  </div>
</header>
